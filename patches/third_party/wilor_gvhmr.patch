 def load_wilor(checkpoint_path, cfg_path):
+    import gc
+    import torch
     from pathlib import Path
     from wilor.configs import get_config
     print('Loading ', checkpoint_path)
@@ -32,5 +34,30 @@ def load_wilor(checkpoint_path, cfg_path):
         model_cfg.MANO.MEAN_PARAMS = './mano_data/mano_mean_params.npz'
         model_cfg.freeze()
 
-    model = WiLoR.load_from_checkpoint(checkpoint_path, strict=False, cfg=model_cfg)
+    # Lightning's load_from_checkpoint materializes this 2.4 GiB checkpoint
+    # in anonymous RAM in addition to the freshly-created model.  Together
+    # with the Hand4Whole++ network this can stall a 16 GiB workstation badly
+    # enough to require a hard reset.  Inference does not need Lightning's
+    # checkpoint migration or renderer, so map the tensors directly from disk
+    # and replace the initialized parameters without making a second copy.
+    model = WiLoR(cfg=model_cfg, init_renderer=False)
+    checkpoint = torch.load(
+        checkpoint_path,
+        map_location="cpu",
+        weights_only=True,
+        mmap=True,
+    )
+    incompatible = model.load_state_dict(
+        checkpoint["state_dict"],
+        strict=False,
+        assign=True,
+    )
+    if incompatible.missing_keys or incompatible.unexpected_keys:
+        print(
+            "WiLoR checkpoint compatibility: "
+            f"missing={len(incompatible.missing_keys)}, "
+            f"unexpected={len(incompatible.unexpected_keys)}"
+        )
+    del checkpoint
+    gc.collect()
     return model, model_cfg
