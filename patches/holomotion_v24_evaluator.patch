+    def _semantic_chair_contact_metrics(self) -> tuple[int, float, float]:
+        """Measure only actual robot--semantic-chair contacts at this state.
+
+        The method does not infer support from reference poses.  With no
+        imported chair (the floor-only prerequisite), it deterministically
+        returns zeros.  A zero minimum distance is deliberate: the V24 audit
+        separately performs exact zero-cutoff geometry penetration checks.
+        """
+        chair_geom_ids = {
+            geom_id
+            for geom_id in range(self.m.ngeom)
+            if (
+                mujoco.mj_id2name(self.m, mujoco.mjtObj.mjOBJ_GEOM, geom_id)
+                in SEMANTIC_CHAIR_GEOM_NAMES
+            )
+        }
+        if not chair_geom_ids:
+            return 0, 0.0, 0.0
+        seat_geom_id = mujoco.mj_name2id(
+            self.m, mujoco.mjtObj.mjOBJ_GEOM, "seat_support_geom"
+        )
+        count = 0
+        seat_normal_force = 0.0
+        minimum_distance = 0.0
+        contact_wrench = np.zeros(6, dtype=np.float64)
+        for contact_index in range(self.d.ncon):
+            contact = self.d.contact[contact_index]
+            pair = {int(contact.geom1), int(contact.geom2)}
+            chair_members = pair & chair_geom_ids
+            if not chair_members:
+                continue
+            other_members = pair - chair_members
+            if not other_members:
+                continue
+            # World geoms (floor and static chair) are not robot contacts.
+            if any(int(self.m.geom_bodyid[geom_id]) == 0 for geom_id in other_members):
+                continue
+            mujoco.mj_contactForce(self.m, self.d, contact_index, contact_wrench)
+            normal_force = max(0.0, float(contact_wrench[0]))
+            count += 1
+            minimum_distance = min(minimum_distance, float(contact.dist))
+            if seat_geom_id in chair_members:
+                seat_normal_force += normal_force
+        return count, seat_normal_force, minimum_distance
 
